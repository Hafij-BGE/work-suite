    </group>
    <!-- Slides: the middle card, turned right. -->
    <group android:rotation="12" android:pivotX="54" android:pivotY="60">
        <path android:fillColor="#D95B2B" android:pathData="M48,34 h30 a3,3 0 0 1 3,3 v34 a3,3 0 0 1 -3,3 h-30 a3,3 0 0 1 -3,-3 v-34 a3,3 0 0 1 3,-3 z" />
        <path android:fillColor="#FFFFFF" android:pathData="M59,47 L71,54 L59,61 Z" />
