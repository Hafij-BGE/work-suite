<?xml version="1.0" encoding="utf-8"?>
<!-- WorkSuite launcher icon, foreground: three cards fanned out, one for each app: a spreadsheet
     grid (green), a slide with a play mark (orange) and a page of text (blue, in front). Everything
     sits inside the 66 dp safe circle. Original artwork for this repository (see ATTRIBUTION.md). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Sheets: the back card, turned left. -->
    <group android:rotation="-14" android:pivotX="54" android:pivotY="60">
        <path android:fillColor="#1E8A4C" android:pathData="M30,36 h30 a3,3 0 0 1 3,3 v34 a3,3 0 0 1 -3,3 h-30 a3,3 0 0 1 -3,-3 v-34 a3,3 0 0 1 3,-3 z" />
