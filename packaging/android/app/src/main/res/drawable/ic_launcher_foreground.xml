    <!-- Writer: the front card. -->
    <path android:fillColor="#FFFFFF" android:pathData="M40,40 h26 a3,3 0 0 1 3,3 v34 a3,3 0 0 1 -3,3 h-26 a3,3 0 0 1 -3,-3 v-34 a3,3 0 0 1 3,-3 z" />
