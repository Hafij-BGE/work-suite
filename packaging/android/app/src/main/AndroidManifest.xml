<?xml version="1.0" encoding="utf-8"?>
<!-- WordCraft for Android: a NativeActivity running the Rust library apps/wordcraft-android
     (no Java code). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- wgpu draws with Vulkan, or OpenGL ES 3 where there is no Vulkan driver. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Documents/WordCraft in shared storage: Android 10 and earlier need these; Android 11 and
         later let the app write its own files there without them. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Optional "All files access" (granted by the user in Settings), to open documents other
         apps saved, such as Download/report.docx. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="WordCraft"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Every configuration change is handled by the app (eframe resizes): Android must never
             restart the activity, since the app's event loop can only be created once a process. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="wordcraft_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
